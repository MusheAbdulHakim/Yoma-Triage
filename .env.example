ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db.example.supabase.co:5432/postgres

# Africa's Talking (SMS/USSD) — leave API key empty for mock mode
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=sandbox
# Registered USSD shortcode (sandbox or production). Example: *384*99193#
AT_USSD_SERVICE_CODE=
# Optional override. Empty → sandbox host when AT_USERNAME=sandbox, else live.
# Live: https://api.africastalking.com
# Sandbox: https://api.sandbox.africastalking.com
AT_API_BASE_URL=

# Public HTTPS origin for AT SMS/USSD callbacks (ngrok or staging host).
# Change anytime you restart ngrok — do not hardcode in Python/Dart.
# Example: PUBLIC_BASE_URL=https://abcd-1-2-3-4.ngrok-free.app
PUBLIC_BASE_URL=
# Optional override for scripts/demo_flow.py (defaults to http://127.0.0.1:8000)
DEMO_API_BASE_URL=http://127.0.0.1:8000

# CHO app breath-screening countdown (seconds). Pass into Flutter as:
#   --dart-define=SCREENING_DURATION_SEC=$SCREENING_DURATION_SEC
# Default in the app is 15 if unset.
SCREENING_DURATION_SEC=30

# Flutter web demo CORS allowlist (comma-separated origins).
# SOP: flutter run -d chrome --web-port=8080
# If Flutter picks another port, add that exact Origin here and reload the API.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5000,http://127.0.0.1:5000,http://localhost:7357,http://127.0.0.1:7357

GEMINI_API_KEY=
MOMO_API_URL=https://sandbox.momodeveloper.mtn.com
MOMO_PRIMARY_KEY=
# Demo-short cascade wait (seconds). Field/pilot: try 60–180.
CASCADE_TIER_SECONDS=5
VECTOR_STORE_DIR=./data/vector_store
